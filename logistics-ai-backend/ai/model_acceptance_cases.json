      "category": "计算",
      "role": "owner",
      "prompt": "WB-SYN-001 和 WB-SYN-002 的运费合计是多少？请给出计算结果。",
      "must_contain_any": [
        "1880.5",
        "1880.50"
      ],
      "require_evidence": true
    },
