      "require_evidence": true
    },
    {
      "id": "LOG-02",
      "category": "物流查询",
      "role": "employee_a",
      "prompt": "运单 WB-SYN-001 的货物和件数是什么？",
      "must_contain": [
        "纺织品",
        "20"
      ],
      "require_evidence": true
    },
    {
      "id": "LOG-03",
      "category": "物流查询",
      "role": "employee_a",
      "prompt": "WB-SYN-001 由哪家合成承运方承运？日期是什么？",
