    {
      "id": "LOG-10",
      "category": "物流查询",
      "role": "employee_a",
      "prompt": "查询虚构编号 WB-DOES-NOT-EXIST 的到站，不要猜。",
      "must_contain_any": [
        "没有查到",
        "未找到",
        "不知道",
        "没有相关",
        "无法确认",
        "查不到"
      ],
      "must_not_contain": [
        "杭州",
        "苏州",
        "合肥"
      ]
    },
    {
