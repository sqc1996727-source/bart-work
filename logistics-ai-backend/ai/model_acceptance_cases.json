    {
      "id": "LOG-08",
      "category": "回单状态",
      "role": "employee_a",
      "prompt": "WB-SYN-001 的厂家交付回单状态是什么？",
      "must_contain_any": [
        "未交",
        "尚未交",
        "没有交"
      ],
      "require_evidence": true
    },
    {
      "id": "LOG-09",
      "category": "费用查询",
      "role": "owner",
