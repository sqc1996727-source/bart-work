      "id": "CALC-12",
      "category": "计算",
      "role": "owner",
      "prompt": "依据V9运单重量字段口径，WB-SYN-001 和 WB-SYN-002 的总重量是多少吨？",
      "must_match_regex": [
        "(?:^|\\D)2(?:\\.0+)?\\s*吨"
