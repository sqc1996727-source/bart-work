      "id": "CALC-13",
      "category": "计算",
      "role": "owner",
      "prompt": "本次合成账本中三票运单共有多少票？请根据 WB-SYN-001、WB-SYN-002、WB-SYN-003 核算。",
      "must_match_regex": [
        "(?:3|三)\\s*(?:票|张|个运单)"
      ],
      "require_evidence": true
    },
    {
      "id": "CALC-14",
      "category": "计算",
      "role": "owner",
      "prompt": "WB-SYN-001 和 WB-SYN-002 的合成进仓费合计多少？",
      "must_contain_any": [
        "50元",
        "50.00",
        "50块"
      ],
      "require_evidence": true
