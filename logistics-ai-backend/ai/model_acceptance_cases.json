    {
      "id": "CALC-15",
      "category": "计算",
      "role": "owner",
      "prompt": "只汇总 WB-SYN-002 的确认进仓费金额。",
      "must_contain_any": [
        "30元",
        "30.00",
        "30块"
      ],
      "require_evidence": true
    },
